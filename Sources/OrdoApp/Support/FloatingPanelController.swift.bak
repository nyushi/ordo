import AppKit
import SwiftUI

@MainActor
final class FloatingPanelController: NSWindowController {
    init(rootView: ContentView) {
        let contentRect = NSRect(x: 200, y: 200, width: 420, height: 520)
        let panel = FloatingPanel(contentRect: contentRect)
        panel.contentView = NSHostingView(rootView: rootView)
        super.init(window: panel)
        window?.isReleasedWhenClosed = false
    }

    @available(*, unavailable)
    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    func toggleVisibility() {
        guard let window else { return }
        if window.isVisible {
            window.orderOut(nil)
        } else {
            showWindow(nil)
            (window as? FloatingPanel)?.enterAmbientMode()
            window.orderFrontRegardless()
        }
    }

    func orderFrontRegardless() {
        guard let window else { return }
        if let floating = window as? FloatingPanel {
            floating.enterAmbientMode()
        }
        window.orderFrontRegardless()
        if NSApp.isActive {
            NSApp.deactivate()
        }
    }
}

private final class FloatingPanel: NSWindow {
    private var trackingArea: NSTrackingArea?
    private var isPointerInside = false
    private let inactiveAlpha: CGFloat = 0.32
    private let focusAlpha: CGFloat = 0.96
    private let activationZoneHeight: CGFloat = 48
    private var interactionEnabled = false
    private var forwardingPointer = false

    init(contentRect: NSRect) {
        super.init(
            contentRect: contentRect,
            styleMask: [
                .titled,
                .fullSizeContentView,
                .closable,
                .resizable
            ],
            backing: .buffered,
            defer: false)
        animationBehavior = .utilityWindow
        if let button = standardWindowButton(.zoomButton) {
            button.isHidden = true
        }
        if let button = standardWindowButton(.miniaturizeButton) {
            button.isHidden = true
        }
        titleVisibility = .hidden
        titlebarAppearsTransparent = true
        isMovableByWindowBackground = true
        hidesOnDeactivate = false
        collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary, .stationary]
        minSize = NSSize(width: 340, height: 280)
        level = .floating
        backgroundColor = NSColor.windowBackgroundColor.withAlphaComponent(0.9)
        isOpaque = false
        hasShadow = true
        alphaValue = inactiveAlpha
        acceptsMouseMovedEvents = true
        enterAmbientMode()
    }

    override var contentView: NSView? {
        didSet {
            if let old = oldValue, let trackingArea {
                old.removeTrackingArea(trackingArea)
            }
            installTrackingArea()
        }
    }

    override var canBecomeKey: Bool { true }
    override var canBecomeMain: Bool { true }

    override func becomeKey() {
        super.becomeKey()
        interactionEnabled = true
        updateTransparency()
    }

    override func resignKey() {
        super.resignKey()
        interactionEnabled = false
        forwardingPointer = false
        updateTransparency()
    }

    override func mouseEntered(with event: NSEvent) {
        super.mouseEntered(with: event)
        isPointerInside = true
        updateTransparency()
    }

    override func mouseExited(with event: NSEvent) {
        super.mouseExited(with: event)
        isPointerInside = false
        updateTransparency()
    }

    override func sendEvent(_ event: NSEvent) {
        guard shouldFilter(event: event) else {
            super.sendEvent(event)
            return
        }

        handleFilteredEvent(event)
    }

    private func shouldFilter(event: NSEvent) -> Bool {
        guard !interactionEnabled else { return false }
        guard event.window === self else { return false }
        switch event.type {
        case .leftMouseDown, .leftMouseUp, .leftMouseDragged:
            return true
        default:
            return forwardingPointer
        }
    }

    private func handleFilteredEvent(_ event: NSEvent) {
        let location = event.locationInWindow
        let activationYThreshold = frame.height - activationZoneHeight
        let isActivationClick = location.y >= activationYThreshold

        if isActivationClick {
            interactionEnabled = true
            forwardingPointer = false
            makeKeyAndOrderFront(nil)
            super.sendEvent(event)
            return
        }

        switch event.type {
        case .leftMouseDown:
            forwardingPointer = true
            forwardEventToSystem(event)
        case .leftMouseDragged:
            forwardEventToSystem(event)
        case .leftMouseUp:
            forwardEventToSystem(event)
            forwardingPointer = false
            enterAmbientMode()
        default:
            forwardEventToSystem(event)
        }
    }

    private func forwardEventToSystem(_ event: NSEvent) {
        guard let cgEvent = event.cgEvent else { return }
        ignoresMouseEvents = true
        cgEvent.post(tap: .cghidEventTap)
        let delay = (event.type == .leftMouseDown) ? 0.01 : 0.0
        DispatchQueue.main.asyncAfter(deadline: .now() + delay) { [weak self] in
            self?.ignoresMouseEvents = false
        }
    }

    func enterAmbientMode() {
        interactionEnabled = false
        forwardingPointer = false
        makeFirstResponder(nil)
        updateTransparency()
        NSApp.deactivate()
    }

    private func installTrackingArea() {
        guard let contentView else { return }
        let options: NSTrackingArea.Options = [
            .mouseEnteredAndExited,
            .activeAlways,
            .inVisibleRect
        ]
        let area = NSTrackingArea(rect: contentView.bounds, options: options, owner: self, userInfo: nil)
        contentView.addTrackingArea(area)
        trackingArea = area
    }

    private func updateTransparency() {
        let target = (isPointerInside && interactionEnabled) ? focusAlpha : inactiveAlpha
        NSAnimationContext.runAnimationGroup { context in
            context.duration = 0.18
            self.animator().alphaValue = target
        }
    }
}
